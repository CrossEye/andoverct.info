{
  "name": "andoverct-build",
  "version": "1.0.0",
  "private": true,
  "description": "Build tooling for andoverct.info (reports + the-facts)",
  "scripts": {
    "setup": "npm install && npm --prefix reference/video install",
    "report": "node _build/report.mjs",
    "report:all": "node _build/report.mjs --all",
    "rebuild:reports": "node _build/report.mjs --all",
    "rebuild:the-facts": "node the-facts/_build/render.js --all",
    "rebuild:town-charter": "node town-charter/convert.js",
    "rebuild:links": "node _build/links.mjs",
    "rebuild:explore": "node _build/build-explore.mjs",
    "rebuild:private": "node _build/report.mjs --private",
    "videos:discover": "node reference/video/discover-meetings.js",
    "rebuild:videos": "npm run rebuild:videos:town && npm run rebuild:videos:boe",
    "rebuild:videos:town": "node reference/video/transcribe-deepgram.js --missing-town",
    "rebuild:videos:boe": "node reference/video/transcribe-deepgram.js --missing",
    "rebuild:videos:index": "node reference/video/download-transcripts.js --rebuild=index",
    "rebuild:all": "npm run rebuild:reports && npm run rebuild:the-facts && npm run rebuild:town-charter && npm run rebuild:links && npm run rebuild:private",
    "render:town-asset": "node _build/town-asset-render.mjs",
    "stage:town-asset": "node _build/town-asset-stage.mjs",
    "reconcile:town-asset": "node _build/town-asset-reconcile.mjs",
    "rebuild:town-asset": "npm run render:town-asset && npm run reconcile:town-asset -- --finalize --step 13",
    "preview": "node _build/preview.mjs --open",
    "preview:stop": "node _build/preview.mjs --stop",
    "deploy": "node _build/deploy.mjs",
    "deploy:go": "node _build/deploy.mjs --deploy",
    "publish": "npm run rebuild:all && npm run deploy:go"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "basic-ftp": "^6.0.1",
    "exceljs": "^4.4.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.2.1",
    "marked": "^14.1.3",
    "marked-smartypants": "^1.1.12"
  }
}
