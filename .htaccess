# ---------------------------------------------------------------------------
# andoverct.info — document-root .htaccess
# ---------------------------------------------------------------------------

# No automatic directory listings. Index-less directories return 403 instead of
# exposing a file listing. Deliberate listings are served on demand by idx.php
# via the /<dir>/idx rewrite below, which is unaffected by this.
Options -Indexes

# Site-styled 404 page (root-relative assets, so it works at any depth).
ErrorDocument 404 /404.html

# Everything text on this site is UTF-8. Applies only to text/plain and
# text/html responses; without it, extension-less text (README.md etc.) falls
# back to the browser's Latin-1 default and mojibakes.
AddDefaultCharset UTF-8

# The host serves .json as text/plain, which contradicts the
# <link rel="alternate" type="application/json"> on the transcript pages and
# makes strict consumers refuse to parse the machine-readable transcripts.
# mod_mime directives, unlike mod_rewrite rulesets, are inherited by
# subdirectories, so this one declaration covers the whole site.
AddType application/json .json

# Route /<anything>/idx through the directory-index helper.
RewriteEngine On

# Canonicalise www to the apex, first, so every rule below only ever sees
# either andoverct.info or a dev hostname. Without this, www falls through the
# host-scoped rules to the scheme-less fallbacks and gets redirected to http://
# -- the same downgrade the rules below exist to prevent. QSA keeps the query
# string; the fbclid rules then run on the apex.
#
# The target MUST use %{REQUEST_URI}, not a captured path. On the www hostname
# this .htaccess is applied with a per-directory prefix that leaves "www/" on
# the front of the match, so `$1` expands to "www/reports/..." and every www URL
# 301s to /www/... and 404s. That shipped live 2026-08-26 to 2026-09-02.
RewriteCond %{HTTP_HOST} ^www\.andoverct\.info$ [NC]
RewriteRule ^ https://andoverct.info%{REQUEST_URI} [R=301,L,QSA]

# ---------------------------------------------------------------------------
# Redirect scheme correction (see the note at the end of this file).
#
# Apache cannot tell https from http here, so any redirect it builds itself
# comes out as http:// and costs an extra hop through the front end — or traps
# strict clients in a loop. Both redirects this site emits are therefore given
# an explicit absolute https target, scoped to the live hostname so the plain
# -http dev box (andoverct.local) keeps Apache's default behaviour.

# Directories: emit the trailing-slash redirect ourselves, before mod_dir can
# emit a scheme-downgrading one. Requests for /<dir>/idx are unaffected (the
# path is not a directory, so the -d test fails and the idx rule below wins).
RewriteCond %{HTTP_HOST} ^andoverct\.info$ [NC]
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ https://andoverct.info/$1/ [R=301,L]

# Strip Facebook's click-tracking parameter from inbound links. Facebook appends
# ?fbclid=... (sometimes fbid=...) to outbound URLs; when present, 301 to the same
# path with the query string dropped. The trailing "?" in the target discards the
# query string. Written in the same plain style as the idx rule below so the
# host's mod_rewrite accepts it.
RewriteCond %{QUERY_STRING} (^|&)fbclid= [NC,OR]
RewriteCond %{QUERY_STRING} (^|&)fbid= [NC]
RewriteCond %{HTTP_HOST} ^andoverct\.info$ [NC]
RewriteRule ^(.*)$ https://andoverct.info/$1? [R=301,L]

# Same, for any other hostname (dev): relative target, no scheme forced. The
# dev box is plain http, so forcing https here would break it.
# htaccess-check: allow-relative
RewriteCond %{QUERY_STRING} (^|&)fbclid= [NC,OR]
RewriteCond %{QUERY_STRING} (^|&)fbid= [NC]
RewriteRule ^(.*)$ /$1? [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*/)?idx/?$ /idx.php?dir=$1 [L,QSA]

# ---------------------------------------------------------------------------
# Why the redirects above name their scheme explicitly
# ---------------------------------------------------------------------------
# TLS is terminated by the SSL front end, which proxies to Apache over plain
# HTTP. Probed 2026-08-26 with a temporary mod_rewrite rule reflecting the
# request environment; re-probed 2026-09-02 after the host acted on the ticket:
#
#   2026-08-26   X-Forwarded-Proto: (absent)   HTTPS: off   SERVER_PORT: 80
#   2026-09-02   X-Forwarded-Proto: https      HTTPS: off   SERVER_PORT: 80
#
# The header now arrives, but HTTPS is still off and REQUEST_SCHEME is still
# unset, so Apache on its own STILL builds http:// redirects and the explicit
# https:// targets above remain load-bearing. What the header unlocks is the
# option of `SetEnvIf X-Forwarded-Proto https HTTPS=on`, which would let Apache
# get this right by itself and retire the per-rule workaround (and its repeats
# in the-facts/, private/ and town-charter/). That refactor has not been done.
#
# The symptom this fixes: https://andoverct.info/reports (no trailing slash)
# used to 301 to http://andoverct.info/reports/, which the front end then 301'd
# back to https. Browsers and curl follow both hops; clients that refuse a
# downgrade — Anthropic's web fetcher among them — reported "too many
# redirects" and could not read the site at all.
