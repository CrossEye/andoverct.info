# ---------------------------------------------------------------------------
# andoverct.info — document-root .htaccess
# ---------------------------------------------------------------------------

# No automatic directory listings. Index-less directories return 403 instead of
# exposing a file listing. Deliberate listings are served on demand by idx.php
# via the /<dir>/idx rewrite below, which is unaffected by this.
Options -Indexes

# Route /<anything>/idx through the directory-index helper.
RewriteEngine On

# Strip Facebook's click-tracking parameter from inbound links. Facebook appends
# ?fbclid=... (sometimes fbid=...) to outbound URLs; when present, 301 to the same
# path with the query string dropped. The trailing "?" in the target discards the
# query string. Written in the same plain style as the idx rule below so the
# host's mod_rewrite accepts it.
RewriteCond %{QUERY_STRING} (^|&)fbclid= [NC,OR]
RewriteCond %{QUERY_STRING} (^|&)fbid= [NC]
RewriteRule ^(.*)$ /$1? [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*/)?idx/?$ /idx.php?dir=$1 [L,QSA]


